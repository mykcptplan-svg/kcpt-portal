# Frontend (Next.js) — auth only via supabase-js (login, session handling).
# Never use these for direct database table queries; all data access goes through
# Supabase Edge Functions called from lib/api/ with Authorization: Bearer <token>.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Edge Functions only — NOT a Vercel/frontend env var.
# Set this as a Supabase secret for the inviteUserByEmail() Edge Function only.
# Do not add to Vercel project settings or any client-side code.
SUPABASE_SERVICE_ROLE_KEY=
